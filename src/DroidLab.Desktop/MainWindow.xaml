nected devices" x:Name="DeviceCards" SelectionChanged="CardSelected" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" MaxHeight="240"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="6" Padding="12" Margin="2"><StackPanel><TextBlock Text="{Binding Serial}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding Transport}" Foreground="{DynamicResource Blue}"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,8,0,12"><Button x:Name="CardRefresh" Content="Refresh diagnostics" Click="RefreshCardMetrics" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CardIdentity" Content="Device intelligence" Click="OpenCardIdentity" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CardTroubleshoot" Content="Troubleshooting" Click="OpenCardTroubleshooting" IsEnabled="False"/></WrapPanel><TextBlock x:Name="MeterStatus" Text="Select an authorized ADB device." TextWrapping="Wrap"/><UniformGrid Columns="3" Margin="0,10,0,0"><Border Background="{DynamicResource Canvas}" CornerRadius="6" Padding="10" Margin="3"><StackPanel><TextBlock Text="Battery charge" TextWrapping="Wrap"/><TextBlock x:Name="BatteryMeterText" Text="Unknown" FontSize="20" Foreground="{DynamicResource Accent}"/><ProgressBar x:Name="BatteryMeter" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource Accent}" Visibility="Hidden"/></StackPanel></Border><Border Background="{DynamicResource Canvas}" CornerRadius="6" Padding="10" Margin="3"><StackPanel><TextBlock Text="Memory used" TextWrapping="Wrap"/><TextBlock x:Name="MemoryMeterText" Text="Unknown" FontSize="20" Foreground="{DynamicResource Accent}"/><ProgressBar x:Name="MemoryMeter" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource Accent}" Visibility="Hidden"/></StackPanel></Border><Border Backgrou