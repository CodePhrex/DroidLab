Left" Padding="12,6"/></StackPanel><StackPanel x:Name="VerifyPanel" Visibility="Collapsed" Margin="0,0,0,12"><Button x:Name="VerifyButton" Content="Verify existing backup" Click="VerifyBackup" HorizontalAlignment="Left" Padding="12,6"/><Button x:Name="RestoreButton" Content="Restore verified backup to staging folder" Click="RestoreBackup" HorizontalAlignment="Left" Padding="12,6" Margin="0,6,0,0"/></StackPanel><StackPanel x:Name="RebootPanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="Reboot selected authorized device"/><ComboBox x:Name="RebootPicker" Margin="0,4,0,8"/><CheckBox x:Name="RecoveryBackupAck" Content="I acknowledge backup and recovery risks"/><WrapPanel><Button x:Name="GuidedRecoveryButton" Content="Guided reboot and verify" Click="RunGuidedRecovery"/><Button Content="Export recovery session" Click="ExportRecoverySession"/></WrapPanel><Button x:Name="RebootButton" Content="Request reboot" Click="RequestReboot" HorizontalAlignment="Left" Padding="12,6"/></StackPanel><StackPanel x:Name="CvePanel" Visibility="Collapsed" Margin="0,0,0,12"><Button x:Name="BulletinButton" Content="Import bulletin JSON and correlate device" Click="CorrelateBulletin" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="Public CVE keyword (sent to NVD; no private identifiers)"/><TextBox x:Name="CveKeyword" Text="Android" Margin="0,4,0,8"/><Button x:Name="CveButton" Content="Search NVD and CISA KEV" Click="SearchCve" HorizontalAlignment="Left" Padding="12,6"/><WrapPanel Margin="0,6,0,0"><Button Content="Load cached results" Click="LoadCachedCve" Padding="12,6" Margin="0,0,8,0"/><Button Content="Export JSON report" Click="ExportCve" Padding="12,6"/></WrapPanel></StackPanel><StackPanel x:Name="TechnicianPanel" Visibility="Collapsed"><TextBlock Text="Device serial"/><TextBox x:Name="ServiceSerial"/><TextBlock Text="Operation"/><TextBox x:Name="ServiceOperation"/><TextBlock Text="Service notes (no passwords)"/><TextBox x:Name="ServiceNotes"/><Button Content="Save service record" Click="SaveService"/><TextBox x:Name="ServiceQuery" Margin="0,8,0,0"/><WrapPanel><Button Content="Search history" Click="SearchService"/><Button Content="Export matching records" Click="ExportService"/></WrapPanel></StackPanel><StackPanel x:Name="TroubleshootPanel" Visibility="Collapsed"><WrapPanel><Button x:Name="TroubleshootButton" Content="Run troubleshooting assessment" Click="RunTroubleshooting" Padding="12,6"/><Button Content="Export assessment" Click="ExportTroubleshooting" Margin="8,0,0,0"/></WrapPanel></StackPanel><StackPanel x:Name="AppsPanel" Visibility="Collapsed"><TextBlock Text="Package filter or exact package identifier"/><TextBox x:Name="PackageQuery"/><WrapPanel><Button Content="List packages" Click="ListApps"/><Button Content="Metadata and permissions" Click="AppMetadata"/><Button Content="Install APK" Click="InstallApp"/><Button Content="Uninstall package" Click="UninstallApp"/></WrapPanel></StackPanel><StackPanel x:Name="StoragePanel" Visibility="Collapsed"><TextBlock Text="Relative shared storage path (e.g. Download)"/><TextBox x:Name="SharedQuery" Text="Download"/><WrapPanel><Button Content="List files" Click="ListShared"/><Button Content="Copy to local staging" Click="PullShared"/></WrapPanel></StackPanel><StackPanel x:Name="NetworkPanel" Visibility="Collapsed"><WrapPanel><Button x:Name="NetworkButton" Content="Read network snapshot" Click="ReadNetwork"/><Button Content="Export network report" Click="ExportNetwork" Margin="8,0,0,0"/></WrapPanel></StackPanel><StackPanel x:Name="WorkbenchPanel" Visibility="Collapsed"><TextBlock Text="Workbench target (authorized device only)"/><ComboBox x:Name="WorkbenchDevice" DisplayMemberPath="Serial"/><TextBlock Text="Command search"/><TextBox x:Name="CommandQuery"/><Button Content="Filter commands" Click="FilterCommands"/><ComboBox x:Name="CommandPicker" DisplayMemberPath="Description"/><WrapPanel><Button x:Name="ExecuteCommandButton" Content="Execute read-only command" Click="ExecuteWorkbench"/><Button Content="Session history" Click="ShowCommandHistory"/></WrapPanel></StackPanel><StackPanel x:Name="AiPanel" Visibility="Collapsed"><TextBlock Text="Ollama — local endpoint 127.0.0.1:11434"/><Button x:Name="AiModelsButton" Content="Discover installed models" Click="DiscoverAiModels"/><ComboBox x:Name="AiModelPicker"/><TextBlock Text="Question"/><TextBox x:Name="AiQuestion" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/><TextBlock Text="Optional reviewed diagnostic evidence (remove sensitive data)"/><TextBox x:Name="AiEvidence" MaxLength="24000" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto"/><Button x:Name="AiAskButton" Content="Ask Droid AI" Click="AskDroidAi"/></StackPanel><StackPanel x:Name="ReportPanel" Visibility="Collapsed"><Button x:Name="CollectReportButton" Content="Collect diagnostic report" Click="CollectReport"/><Button Content="Export JSON / CSV / HTML" Click="ExportProfessionalReport"/></StackPanel><StackPanel x:Name="LicensePanel" Visibility="Collapsed"><TextBlock Text="COMMUNITY / PROFESSIONAL / ENTERPRISE" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><TextBlock x:Name="EditionCatalog" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock Text="Development preview — billing and production activation are not configured." TextWrapping="Wrap"/><TextBlock Text="Existing modules remain available during development." TextWrapping="Wrap"/></StackPanel></StackPanel></ScrollViewer><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Edge}" ResizeDirection="Rows"/><DockPanel Grid.Row="2" Background="{DynamicResource Surface}" Margin="12,4,12,12"><DockPanel DockPanel.Dock="Top" Margin="8"><WrapPanel DockPanel.Dock="Right"><Button Content="Copy" Click="CopyOutput" Margin="4,0"/><Button Content="_Detach live output" Click="DetachOutput" Margin="4,0"/><Button Content="Clear" Click="ClearOutput" Margin="4,0"/></WrapPanel><TextBlock 