<Window x:Class="DroidLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="WorkspaceKeyDown" Title="Droid Lab | CodePhrex" Width="1200" Height="800" MinWidth="850" MinHeight="650" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Inter, Segoe UI"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Background="{DynamicResource Surface}"><StackPanel DockPanel.Dock="Top" Margin="20"><Viewbox Width="66" Height="60" HorizontalAlignment="Left" Margin="0,0,0,12"><Canvas Width="120" Height="110"><Path Data="M60,5 L108,32 108,78 60,105 12,78 12,32 Z" Stroke="{DynamicResource Accent}" StrokeThickness="3"/><Path Data="M31,70 L31,53 Q31,31 60,31 Q89,31 89,53 L89,70 Z M39,37 L32,23 M81,37 L88,23" Stroke="{DynamicResource Accent}" StrokeThickness="3"/><Ellipse Canvas.Left="42" Canvas.Top="47" Width="8" Height="8" Fill="{DynamicResource Accent}"/><Ellipse Canvas.Left="70" Canvas.Top="47" Width="8" Height="8" Fill="{DynamicResource Accent}"/><Path Data="M48,62 L72,62" Stroke="{DynamicResource Blue}" StrokeThickness="2"/></Canvas></Viewbox><TextBlock FontFamily="Orbitron, Segoe UI" Text="DROID LAB" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="ENGINEERED BY CODEPHREX" FontSize="10"/><TextBox AutomationProperties.Name="Search workspaces" x:Name="ModuleSearch" ToolTip="Filter modules" TextChanged="FilterModules" Margin="0,16,0,0"/><ComboBox x:Name="AppearancePicker" AutomationProperties.Name="Appearance theme" SelectionChanged="AppearanceChanged" Margin="0,8,0,0"/><TextBlock Text="WORKSPACES" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel><ListBox AutomationProperties.Name="Workspace navigation" x:Name="Navigation" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderT