<Window x:Class="DroidLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Droid Lab | CodePhrex" Width="1200" Height="800" MinWidth="850" MinHeight="650" Background="#0B1119" Foreground="#F2F6FC" FontFamily="Inter, Segoe UI"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Background="#182433"><StackPanel DockPanel.Dock="Top" Margin="20"><TextBlock Text="DROID LAB" FontSize="25" FontWeight="Bold" Foreground="#00E5B0"/><TextBlock Text="ENGINEERED BY CODEPHREX" FontSize="10"/></StackPanel><ListBox x:Name="Navigation" Background="#182433" Foreground="#F2F6FC" BorderThickness="0" SelectionChanged="Navigate"/></DockPanel><StackPanel Grid.Column="1" Margin="32"><TextBlock x:Name="Heading" FontSize="32" FontWeight="Bold"/><TextBlock Text="Beyond Device Management." Foreground="#00E5B0" Margin="0,8,0,24"/><TextBlock x:Name="Description" TextWrapping="Wrap" FontSize="16"/><Button x:Name="Scan" Content="Detect Android devices" Click="Detect" HorizontalAlignment="Left" Padding="16,10" Margin="0,24,0,12" Background="#00E5B0"/><StackPanel x:Name="DiagnosticPanel" Margin="0,0,0,12"><TextBlock Text="Authorized ADB device"/><ComboBox x:Name="DevicePicker" DisplayMemberPath="Serial" Margin="0,4,0,8"/><ComboBox x:Name="DiagnosticPicker" Margin="0,0,0,8"/><Button x:Name="ReadButton" Content="Read diagnostic" Click="ReadDiagnostic" HorizontalAlignment="Left" Padding="12,6"/></StackPanel><StackPanel x:Name="FirmwarePanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="Firmware package (local file)"/><DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseFirmware" Padding="12,4"/><TextBox x:Name="FirmwarePath" IsReadOnly="True"/></DockPanel><TextBlock Text="Expected SHA-256 (optional, from trusted OEM source)"/><TextBox x:Name="ExpectedHash" Margin="0,4,0,8"/><Button x:Name="InspectButton" Content="Inspect firmware" Click="InspectFirmware" HorizontalAlignment="Left" Padding="12,6"/></StackPanel><StackPanel x:Name="BackupPanel" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="Shared storage folder to copy"/><ComboBox x:Name="BackupPicker" Margin="0,4,0,8"/><Button x:Name="BackupButton" Content="Choose destination and back up" Click="RunBackup" HorizontalAlignment="Left" Padding="12,6"/></StackPanel><TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="280" Background="#182433" Foreground="#F2F6FC" FontFamily="Consolas"/></StackPanel></Grid></Window>